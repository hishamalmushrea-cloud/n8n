    }
  },
  "meta": {
    "instanceId": "arena-strix-only",
    "notes": "100% Arena.ai Agent Mode ONLY. Strix uses Arena via OpenAI-compatible proxy at localhost:8080 - no API keys. Security + Build + Improve loop."
  }
