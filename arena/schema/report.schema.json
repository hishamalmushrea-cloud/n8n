{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arena.report/1",
  "title": "Arena pentest report (what `arena complete` writes to report.json)",
  "type": "object",
  "required": ["id", "generated_at", "target", "counts", "findings"],
  "properties": {
    "id": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "summary": { "type": "string" },
    "target": { "type": "string" },
    "mode": { "enum": ["quick", "standard", "full", "deep", "compliance", "retest"] },
    "counts": {
      "type": "object",
      "properties": {
        "total": { "type": "integer" },
        "open": { "type": "integer" },
        "blocking": { "type": "integer" },
        "fixed_verified": { "type": "integer" },
        "by_severity": { "type": "object" }
      }
    },
    "findings": { "type": "array", "items": { "$ref": "arena.finding/1" } },
    "evidence": { "type": "array", "items": { "type": "string" } }
  }
}
